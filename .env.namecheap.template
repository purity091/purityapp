# Production Environment Configuration for Namecheap Hosting

# ========================================
# Database Configuration (Namecheap MySQL)
# ========================================
# Get these from your Namecheap cPanel > MySQL Databases
DB_HOST=your_namecheap_mysql_hostname.com
DB_USER=your_database_username
DB_PASSWORD=your_strong_database_password
DB_NAME=your_database_name
DB_PORT=3306

# ========================================
# JWT Secret Keys
# ========================================
# IMPORTANT: Generate strong random strings for production!
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_STRING_64_CHARS_OR_MORE
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_RANDOM_STRING_64_CHARS_OR_MORE

# ========================================
# JWT Token Expiration
# ========================================
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ========================================
# Server Configuration
# ========================================
PORT=3001
NODE_ENV=production

# ========================================
# CORS Configuration
# ========================================
# Replace with your actual domain
CORS_ORIGIN=https://yourdomain.com

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# ========================================
# INSTRUCTIONS:
# ========================================
# 1. Copy this file to your Namecheap server
# 2. Rename it to .env
# 3. Replace ALL placeholder values with actual values
# 4. NEVER commit this file to Git
# 5. Keep it secure and private
