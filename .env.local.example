# ========================================
# Supabase Configuration (Production Ready)
# ========================================
# احصل على هذه القيم من: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_USE_SUPABASE=true
VITE_AUTH_REDIRECT_URL=https://your-domain.example/?reset=1
VITE_ENABLE_REALTIME=false

# Server-side Supabase verification (keep secret key on the backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=replace-with-your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Vercel Cron keepalive endpoint (server-side only)
CRON_SECRET=replace-with-a-long-random-cron-secret

# ========================================
# IMPORTANT NOTES:
# ========================================
# 1. اذهب إلى https://supabase.com
# 2. أنشئ مشروع جديد (مجاني)
# 3. انسخ URL و Anon Key من Settings → API
# 4. ضعها هنا
# 5. احفظ الملف
# 6. شغّل: npm run dev
